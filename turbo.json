{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "pnpm-workspace.yaml"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": [".tsbuild/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "package.json", "tsdown.config.*"],
      "outputs": ["dist/**"]
    },
    "test": {
      "inputs": ["src/**", "test/**", "package.json", "vitest.config.*"],
      "outputs": []
    },
    "test:coverage": {
      "inputs": ["src/**", "test/**", "package.json", "vitest.config.*"],
      "outputs": ["coverage/**"]
    },
    "test:related": {
      "cache": false
    },
    "lint": {
      "inputs": ["src/**", "package.json"],
      "outputs": []
    }
  }
}
