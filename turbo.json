{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "pnpm-workspace.yaml"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": [".tsbuild/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "package.json", "tsdown.config.*"],
      "outputs": ["dist/**"]
    },
    "@fluxion/studio#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "index.html", "vite.config.ts", "tsconfig.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "@fluxion/docs#build": {
      "dependsOn": [
        "^build",
        "@fluxion/core#typecheck",
        "@fluxion/dsl#build",
        "@fluxion/schema#build",
        "@fluxion/sdk#build",
        "@fluxion/layout#build",
        "@fluxion/pack-basic#build",
        "@fluxion/pack-themes-core#build"
      ],
      "inputs": [
        "src/**",
        "!src/content/docs/api/**",
        "astro.config.mjs",
        "tsconfig.json",
        "package.json",
        "$TURBO_ROOT$/typedoc.json",
        "$TURBO_ROOT$/packages/core/src/**",
        "$TURBO_ROOT$/packages/core/tsconfig.json",
        "$TURBO_ROOT$/scripts/docs/authoring-guide.mjs",
        "$TURBO_ROOT$/examples/dsl/**",
        "$TURBO_ROOT$/packages/dsl/src/**"
      ],
      "outputs": ["dist/**"]
    }
  }
}
