{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/gates/*.mjs", "scripts/fixtures/*.mjs", "scripts/harness/**/*.mjs", "tools/gen/*.mjs", "tests/harness/*.test.mjs"],
      "project": ["scripts/**/*.mjs", "tools/**/*.mjs", "tests/**/*.mjs", "e2e/**/*.ts", "*.config.ts"],
      "ignoreDependencies": ["@arethetypeswrong/cli", "dependency-cruiser", "@microsoft/api-extractor"]
    }
  },
  "ignoreExportsUsedInFile": true
}
