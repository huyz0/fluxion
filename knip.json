{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/gates/*.mjs",
        "scripts/fixtures/*.mjs",
        "scripts/fonts/*.mjs",
        "scripts/harness/**/*.mjs",
        "scripts/docs/*.mjs",
        "tools/gen/*.mjs",
        "tests/harness/*.test.mjs"
      ],
      "project": ["scripts/**/*.mjs", "tools/**/*.mjs", "tests/**/*.mjs", "e2e/**/*.ts", "*.config.ts"],
      "ignoreDependencies": ["@arethetypeswrong/cli", "dependency-cruiser", "@microsoft/api-extractor", "@huyz0/tzap"]
    }
  },
  "ignoreExportsUsedInFile": true
}
