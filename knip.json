{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/gates/*.mjs",
        "scripts/fixtures/*.mjs",
        "scripts/fonts/*.mjs",
        "scripts/packs/*.mjs",
        "scripts/format/*.mjs",
        "scripts/harness/**/*.mjs",
        "scripts/docs/*.mjs",
        "scripts/examples/*.mjs",
        "tools/gen/*.mjs",
        "tests/harness/*.test.mjs",
        "scripts/i18n/*.mjs",
        "tools/vite-lingui/*.mjs"
      ],
      "project": ["scripts/**/*.mjs", "tools/**/*.mjs", "tests/**/*.mjs", "e2e/**/*.ts", "*.config.ts"],
      "ignoreDependencies": ["@arethetypeswrong/cli", "dependency-cruiser", "@microsoft/api-extractor", "@huyz0/tzap"]
    },
    "apps/studio": {
      "ignoreDependencies": [
        "@fluxion/pack-arrows",
        "@fluxion/pack-bpmn-lite",
        "@fluxion/pack-callouts",
        "@fluxion/pack-cloud-architecture",
        "@fluxion/pack-devices",
        "@fluxion/pack-flowchart",
        "@fluxion/pack-icons-lucide",
        "@fluxion/pack-infographic",
        "@fluxion/pack-network",
        "@fluxion/pack-people",
        "@fluxion/pack-uml"
      ]
    }
  },
  "ignoreExportsUsedInFile": true
}
