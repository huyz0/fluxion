{
  "name": "Fluxion Studio",
  "short_name": "Fluxion",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#2563eb",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/vnd.fluxion+zip": [".flux"],
        "text/html": [".flux.html"]
      }
    }
  ]
}
