{
  "name": "fluxion",
  "private": true,
  "description": "Author, AI-generate and present interactive, animated diagram-screens as one portable file.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.0",
  "engines": {
    "node": ">=22.19",
    "pnpm": ">=11"
  },
  "scripts": {
    "setup": "node scripts/harness/setup.mjs",
    "build": "turbo run build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:related": "vitest related --run",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "verify": "node scripts/gates/precommit.mjs --all",
    "verify:fast": "node scripts/gates/precommit.mjs --quick"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@axe-core/playwright": "catalog:",
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@playwright/test": "catalog:",
    "@size-limit/preset-small-lib": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "catalog:",
    "fast-check": "catalog:",
    "knip": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "size-limit": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
