{
  "name": "@fluxion/dsl",
  "version": "0.0.0",
  "description": "FluxScript parser, compiler, decompiler, diagnostics, Mermaid/Markdown importers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@fluxion/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@fluxion/core": "workspace:*",
    "@fluxion/schema": "workspace:*"
  }
}
