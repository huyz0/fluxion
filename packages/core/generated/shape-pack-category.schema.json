                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "side": {
                  "type": "string",
                  "enum": ["n", "e", "s", "w"]
                },
                "t": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
