          "decorations": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": ["path"],
              "additionalProperties": false
            }
          },
          "describe": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "category": {
            "type": "string"
          },
          "license": {
            "type": "string"
          }
        },
        "required": ["id", "outline", "defaultSize"],
        "additionalProperties": false
      }
    }
  },
  "required": ["formatVersion", "definitions"],
  "additionalProperties": false
}
