                  {
                    "type": "string",
                    "pattern": "^\\{[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*\\}$"
                  }
                ],
                "ui": "slider",
                "group": "Appearance",
                "order": 1,
                "label": "Opacity"
              },
              "radius": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
