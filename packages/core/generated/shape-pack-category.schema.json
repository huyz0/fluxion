                "required": ["path"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "polygon": {
                    "type": "object",
                    "properties": {
                      "n": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "x": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "y": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      }
                    },
                    "required": ["n", "x", "y"],
                    "additionalProperties": false
                  }
                },
                "required": ["polygon"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "points": {
                    "type": "string",
                    "minLength": 1
