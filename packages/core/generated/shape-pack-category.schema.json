                                        "lighten": {
                                          "type": "number",
                                          "minimum": -1,
                                          "maximum": 1
                                        }
                                      },
                                      "additionalProperties": {}
                                    }
                                  },
                                  "required": ["token", "transform"],
                                  "additionalProperties": {}
