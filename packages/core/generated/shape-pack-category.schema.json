                  {
                    "type": "string",
                    "pattern": "^\\{[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*\\}$"
                  }
                ],
                "ui": "number",
                "group": "Appearance",
                "order": 2,
                "label": "Corner radius"
              },
              "shadow": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "blur": {
                      "type": "number",
                      "minimum": 0
                    },
                    "spread": {
                      "type": "number"
                    },
                    "color": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^\\{[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*\\}$"
                        },
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "token": {
                              "type": "string",
                              "pattern": "^\\{[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*\\}$"
                            },
                            "transform": {
                              "type": "object",
                              "properties": {
                                "alpha": {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 1
                                },
                                "lighten": {
                                  "type": "number",
                                  "minimum": -1,
                                  "maximum": 1
                                }
                              },
                              "additionalProperties": {}
                            }
                          },
                          "required": ["token", "transform"],
                          "additionalProperties": {}
                        }
                      ]
                    },
                    "inset": {
                      "type": "boolean"
