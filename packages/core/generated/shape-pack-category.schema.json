                                      "type": "string",
                                      "pattern": "^\\{[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*\\}$"
                                    },
                                    "transform": {
                                      "type": "object",
                                      "properties": {
                                        "alpha": {
                                          "type": "number",
                                          "minimum": 0,
                                          "maximum": 1
