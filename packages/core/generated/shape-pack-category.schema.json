                  "cap": {
                    "type": "string",
                    "enum": ["butt", "round", "square"]
                  },
                  "join": {
                    "type": "string",
                    "enum": ["miter", "round", "bevel"]
                  },
                  "align": {
                    "type": "string",
                    "enum": ["center", "inside", "outside"]
                  }
                },
                "additionalProperties": {}
              },
              "opacity": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
