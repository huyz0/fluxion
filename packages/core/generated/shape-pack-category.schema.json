              "effects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["glow", "blur"]
                    },
                    "radius": {
                      "type": "number",
                      "minimum": 0
                    },
                    "color": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^\\{[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*\\}$"
                        },
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "token": {
                              "type": "string",
                              "pattern": "^\\{[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*\\}$"
                            },
                            "transform": {
                              "type": "object",
                              "properties": {
                                "alpha": {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 1
                                },
                                "lighten": {
                                  "type": "number",
                                  "minimum": -1,
                                  "maximum": 1
                                }
                              },
                              "additionalProperties": {}
                            }
                          },
                          "required": ["token", "transform"],
                          "additionalProperties": {}
                        }
                      ]
                    }
                  },
                  "required": ["type", "radius"],
                  "additionalProperties": {}
                }
              },
              "font": {
                "type": "object",
                "properties": {
                  "family": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\{[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*\\}$"
                      },
                      {
                        "type": "string",
                        "minLength": 1
                      }
                    ]
                  },
                  "size": {
                    "anyOf": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      {
                        "type": "string",
                        "pattern": "^\\{[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*\\}$"
                      }
                    ],
                    "ui": "number",
                    "group": "Text",
                    "order": 1,
                    "label": "Size"
                  },
                  "weight": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 1000
                      },
                      {
                        "type": "string",
                        "pattern": "^\\{[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*\\}$"
                      }
                    ]
                  },
                  "style": {
                    "type": "string",
                    "enum": ["normal", "italic"]
                  },
                  "lineHeight": {
                    "anyOf": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      {
                        "type": "string",
                        "pattern": "^\\{[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*\\}$"
                      }
                    ]
                  },
                  "letterSpacing": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "pattern": "^\\{[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*\\}$"
                      }
                    ]
                  },
                  "color": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\{[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*\\}$"
                      },
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "token": {
                            "type": "string",
                            "pattern": "^\\{[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*\\}$"
                          },
                          "transform": {
                            "type": "object",
                            "properties": {
                              "alpha": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              },
                              "lighten": {
                                "type": "number",
                                "minimum": -1,
                                "maximum": 1
                              }
                            },
                            "additionalProperties": {}
                          }
                        },
                        "required": ["token", "transform"],
                        "additionalProperties": {}
                      }
                    ],
                    "ui": "paint",
                    "group": "Text",
                    "order": 2,
                    "label": "Colour"
                  },
                  "align": {
                    "type": "string",
                    "enum": ["left", "center", "right", "justify"],
                    "ui": "select",
                    "group": "Text",
                    "order": 3,
                    "label": "Align"
                  },
                  "verticalAlign": {
                    "type": "string",
                    "enum": ["top", "middle", "bottom"]
                  }
