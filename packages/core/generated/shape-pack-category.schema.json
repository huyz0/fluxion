                          "transform": {
                            "type": "object",
                            "properties": {
                              "alpha": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              },
                              "lighten": {
                                "type": "number",
                                "minimum": -1,
                                "maximum": 1
