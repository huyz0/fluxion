                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  ]
                },
                "y": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  ]
