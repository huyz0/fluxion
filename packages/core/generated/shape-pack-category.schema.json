                  "closed": {
                    "type": "boolean"
                  },
                  "smooth": {
                    "type": "boolean"
                  }
                },
                "required": ["points"],
                "additionalProperties": false
              }
            ]
          },
          "anchors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": ["fixed", "side", "perimeter", "center"]
