{
  "name": "@fluxion/core",
  "version": "0.0.0",
  "description": "Document store (records + signals), transactions, commands, undo/redo, queries, registries.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@fluxion/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@fluxion/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@fluxion/geometry": "workspace:*",
    "@fluxion/schema": "workspace:*",
    "alien-signals": "catalog:",
    "zod": "catalog:"
  }
}
