{
  "name": "@fluxion/editor",
  "version": "0.0.0",
  "description": "Edit overlay, tools state machine, panels, inspector, library, timeline and interaction editors, AI panel.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@fluxion/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --root ../.. --project browser packages/editor/src"
  },
  "dependencies": {
    "@fluxion/core": "workspace:*",
    "@fluxion/format": "workspace:*",
    "@fluxion/geometry": "workspace:*",
    "@fluxion/player": "workspace:*",
    "@fluxion/render": "workspace:*",
    "@fluxion/routing": "workspace:*",
    "@fluxion/schema": "workspace:*",
    "@fluxion/theme": "workspace:*",
    "prosemirror-commands": "catalog:",
    "prosemirror-history": "catalog:",
    "prosemirror-inputrules": "catalog:",
    "prosemirror-keymap": "catalog:",
    "prosemirror-model": "catalog:",
    "prosemirror-schema-list": "catalog:",
    "prosemirror-state": "catalog:",
    "prosemirror-view": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "axe-core": "catalog:",
    "fast-check": "catalog:",
    "storybook": "catalog:",
    "vite": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
