{
  "name": "@fluxion/cli",
  "version": "0.0.0",
  "description": "The fluxion command: validate, compile, render, lint, layout, convert, catalog, pack, site build.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fluxion": "./dist/bin.js"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "@fluxion/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fluxion/format": "workspace:*",
    "@fluxion/pack-basic": "workspace:*",
    "@fluxion/player-inline": "workspace:*",
    "@fluxion/render": "workspace:*",
    "@fluxion/schema": "workspace:*",
    "@fluxion/sdk": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
