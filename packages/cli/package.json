{
  "name": "@fluxion/cli",
  "version": "0.0.0",
  "description": "The fluxion command: validate, compile, render, lint, layout, convert, catalog, pack, site build.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@fluxion/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
