{
  "name": "@fluxion/render",
  "version": "0.0.0",
  "description": "React 19 DOM+SVG renderer of a screen, identical in edit and present mode.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@fluxion/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ssr": {
      "@fluxion/source": "./src/ssr.ts",
      "types": "./dist/ssr.d.ts",
      "default": "./dist/ssr.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fluxion/core": "workspace:*",
    "@fluxion/geometry": "workspace:*",
    "@fluxion/routing": "workspace:*",
    "@fluxion/schema": "workspace:*",
    "@fluxion/theme": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
