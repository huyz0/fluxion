{
  "name": "@fluxion/format",
  "version": "0.0.0",
  "description": ".flux zip, .flux.html and .flux.json read/write, content-addressed asset store, sanitizers, lockfile.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@fluxion/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./player": {
      "@fluxion/source": "./src/player.ts",
      "types": "./dist/player.d.ts",
      "default": "./dist/player.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@fluxion/schema": "workspace:*"
  }
}
