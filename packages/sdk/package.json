{
  "name": "@fluxion/sdk",
  "version": "0.0.0",
  "description": "Public plugin API: stable contracts, manifest schema, component contract, test harness.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@fluxion/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fluxion/core": "workspace:*",
    "@fluxion/schema": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
