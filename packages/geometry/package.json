{
  "name": "@fluxion/geometry",
  "version": "0.0.0",
  "description": "Vectors, matrices, bezier/path ops, outline sampling, intersections, bounding boxes, spatial index wrappers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@fluxion/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./boolean": {
      "@fluxion/source": "./src/boolean.ts",
      "types": "./dist/boolean.d.ts",
      "default": "./dist/boolean.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "flatbush": "catalog:",
    "polybooljs": "catalog:",
    "rbush": "catalog:"
  },
  "devDependencies": {
    "@types/rbush": "catalog:"
  }
}
