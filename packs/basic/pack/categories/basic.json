{
  "definitions": [
    {
      "category": "basic",
      "defaultSize": {
        "h": 100,
        "w": 160
      },
      "describe": "A rectangle, the default box for a component, step or service.",
      "id": "basic:rect",
      "keywords": [
        "rectangle",
        "box",
        "square"
      ],
      "license": "MIT",
      "outline": {
        "path": "M 0 0 L {w} 0 L {w} {h} L 0 {h} Z"
      }
    },
    {
      "category": "basic",
      "defaultSize": {
        "h": 100,
        "w": 160
      },
      "describe": "A rectangle with rounded corners, a friendly box for steps and cards.",
      "handles": [
        {
          "param": "r",
          "x": "min(r, w/2, h/2)",
          "y": "0"
        }
      ],
      "id": "basic:rounded-rect",
      "keywords": [
        "rounded",
        "rectangle",
        "card",
        "button"
      ],
      "license": "MIT",
      "outline": {
        "path": "M {min(r, w/2, h/2)} 0 H {w - min(r, w/2, h/2)} A {min(r, w/2, h/2)} {min(r, w/2, h/2)} 0 0 1 {w} {min(r, w/2, h/2)} V {h - min(r, w/2, h/2)} A {min(r, w/2, h/2)} {min(r, w/2, h/2)} 0 0 1 {w - min(r, w/2, h/2)} {h} H {min(r, w/2, h/2)} A {min(r, w/2, h/2)} {min(r, w/2, h/2)} 0 0 1 0 {h - min(r, w/2, h/2)} V {min(r, w/2, h/2)} A {min(r, w/2, h/2)} {min(r, w/2, h/2)} 0 0 1 {min(r, w/2, h/2)} 0 Z"
      },
      "params": {
        "r": {
          "default": 12,
          "max": 1000,
          "min": 0,
          "type": "number"
        }
      }
    },
    {
      "category": "basic",
      "defaultSize": {
        "h": 100,
        "w": 140
      },
      "describe": "An ellipse or circle, for start and end points, states and actors.",
      "id": "basic:ellipse",
      "keywords": [
        "ellipse",
        "circle",
        "oval"
      ],
      "license": "MIT",
      "outline": {
        "path": "M 0 {h/2} A {w/2} {h/2} 0 1 1 {w} {h/2} A {w/2} {h/2} 0 1 1 0 {h/2} Z"
      }
    },
    {
      "category": "basic",
      "defaultSize": {
        "h": 100,
        "w": 120
      },
      "describe": "A triangle, for warnings, hierarchies and play buttons.",
      "handles": [
        {
          "param": "apex",
          "x": "w * apex",
          "y": "0"
        }
      ],
      "id": "basic:triangle",
      "keywords": [
        "triangle",
        "warning"
      ],
      "license": "MIT",
      "outline": {
        "path": "M {w * apex} 0 L {w} {h} L 0 {h} Z"
      },
      "params": {
        "apex": {
          "default": 0.5,
          "max": 1,
          "min": 0,
          "type": "number"
        }
      }
    },
    {
      "category": "basic",
      "defaultSize": {
        "h": 100,
        "w": 140
      },
      "describe": "A rhombus, the decision point of a flowchart.",
      "id": "basic:diamond",
      "keywords": [
        "diamond",
        "rhombus",
        "decision"
      ],
      "license": "MIT",
      "outline": {
        "path": "M {w/2} 0 L {w} {h/2} L {w/2} {h} L 0 {h/2} Z"
      }
    },
    {
      "category": "basic",
      "defaultSize": {
        "h": 90,
        "w": 160
      },
      "describe": "A slanted box, the input and output step of a flowchart.",
      "handles": [
        {
          "param": "skew",
          "x": "w * skew",
          "y": "0"
        }
      ],
      "id": "basic:parallelogram",
      "keywords": [
        "parallelogram",
        "input",
        "output"
      ],
      "license": "MIT",
      "outline": {
        "path": "M {w * skew} 0 L {w} 0 L {w - w * skew} {h} L 0 {h} Z"
      },
      "params": {
        "skew": {
          "default": 0.2,
          "max": 0.9,
          "min": 0,
          "type": "number"
        }
      }
    },
    {
      "category": "basic",
      "defaultSize": {
        "h": 90,
        "w": 160
      },
      "describe": "A box with slanted sides, for manual steps and funnels.",
      "handles": [
        {
          "param": "inset",
          "x": "w * inset",
          "y": "0"
        }
      ],
      "id": "basic:trapezoid",
      "keywords": [
        "trapezoid",
        "manual operation"
      ],
      "license": "MIT",
      "outline": {
        "path": "M {w * inset} 0 L {w - w * inset} 0 L {w} {h} L 0 {h} Z"
      },
      "params": {
        "inset": {
          "default": 0.2,
          "max": 0.49,
          "min": 0,
          "type": "number"
        }
      }
    },
    {
      "category": "basic",
      "defaultSize": {
        "h": 120,
        "w": 140
      },
      "describe": "A six-sided shape, for preparation steps, services and cells.",
      "handles": [
        {
          "param": "inset",
          "x": "w * inset",
          "y": "0"
        }
      ],
      "id": "basic:hexagon",
      "keywords": [
        "hexagon",
        "preparation"
      ],
      "license": "MIT",
      "outline": {
        "path": "M {w * inset} 0 L {w - w * inset} 0 L {w} {h/2} L {w - w * inset} {h} L {w * inset} {h} L 0 {h/2} Z"
      },
      "params": {
        "inset": {
          "default": 0.25,
          "max": 0.5,
          "min": 0,
          "type": "number"
        }
      }
    },
    {
      "category": "basic",
      "defaultSize": {
        "h": 120,
        "w": 120
      },
      "describe": "An eight-sided shape, for stop signs and terminators.",
      "handles": [
        {
          "param": "cut",
          "x": "cut * min(w, h)",
          "y": "0"
        }
      ],
      "id": "basic:octagon",
      "keywords": [
        "octagon",
        "stop"
      ],
      "license": "MIT",
      "outline": {
        "path": "M {cut * min(w, h)} 0 L {w - cut * min(w, h)} 0 L {w} {cut * min(w, h)} L {w} {h - cut * min(w, h)} L {w - cut * min(w, h)} {h} L {cut * min(w, h)} {h} L 0 {h - cut * min(w, h)} L 0 {cut * min(w, h)} Z"
      },
      "params": {
        "cut": {
          "default": 0.29,
          "max": 0.5,
          "min": 0,
          "type": "number"
        }
      }
    },
    {
      "category": "basic",
      "defaultSize": {
        "h": 120,
        "w": 120
      },
      "describe": "A star with a chosen number of points, for ratings and highlights.",
      "handles": [
        {
          "param": "inner",
          "x": "w/2 + inner * w/2 * sin(pi / points)",
          "y": "h/2 - inner * h/2 * cos(pi / points)"
        }
      ],
      "id": "basic:star",
      "keywords": [
        "star",
        "rating",
        "favourite"
      ],
      "license": "MIT",
      "outline": {
        "polygon": {
          "n": "2 * points",
          "x": "w/2 + (i % 2 ? inner : 1) * w/2 * sin(2 * pi * i / n)",
          "y": "h/2 - (i % 2 ? inner : 1) * h/2 * cos(2 * pi * i / n)"
        }
      },
      "params": {
        "inner": {
          "default": 0.5,
          "max": 0.95,
          "min": 0.1,
          "type": "number"
        },
        "points": {
          "default": 5,
          "max": 64,
          "min": 3,
          "type": "int"
        }
      }
    },
    {
      "category": "basic",
      "defaultSize": {
        "h": 80,
        "w": 160
      },
      "describe": "A thick arrow block pointing right, for flows, steps and calls to action.",
      "handles": [
        {
          "param": "head",
          "x": "w - w * head",
          "y": "0"
        },
        {
          "param": "shaft",
          "x": "0",
          "y": "h * (1 - shaft) / 2"
        }
      ],
      "id": "basic:block-arrow",
      "keywords": [
        "arrow",
        "next",
        "direction"
      ],
      "license": "MIT",
      "outline": {
        "path": "M 0 {h * (1 - shaft) / 2} L {w - w * head} {h * (1 - shaft) / 2} L {w - w * head} 0 L {w} {h/2} L {w - w * head} {h} L {w - w * head} {h - h * (1 - shaft) / 2} L 0 {h - h * (1 - shaft) / 2} Z"
      },
      "params": {
        "head": {
          "default": 0.35,
          "max": 0.95,
          "min": 0.05,
          "type": "number"
        },
        "shaft": {
          "default": 0.5,
          "max": 0.95,
          "min": 0.05,
          "type": "number"
        }
      }
    },
    {
      "category": "basic",
      "defaultSize": {
        "h": 110,
        "w": 180
      },
      "describe": "A speech-bubble box with a pointer, for comments and annotations.",
      "handles": [
        {
          "param": "tip",
          "x": "w * tip",
          "y": "h"
        }
      ],
      "id": "basic:callout",
      "keywords": [
        "callout",
        "speech",
        "bubble",
        "comment"
      ],
      "license": "MIT",
      "outline": {
        "path": "M 0 0 H {w} V {h - h * tail} H {clamp(w * tip - w * width / 2, 0, w - w * width) + w * width} L {w * tip} {h} L {clamp(w * tip - w * width / 2, 0, w - w * width)} {h - h * tail} H 0 Z"
      },
      "params": {
        "tail": {
          "default": 0.25,
          "max": 0.6,
          "min": 0.05,
          "type": "number"
        },
        "tip": {
          "default": 0.25,
          "max": 1,
          "min": 0,
          "type": "number"
        },
        "width": {
          "default": 0.15,
          "max": 0.9,
          "min": 0.02,
          "type": "number"
        }
      },
      "textRegions": [
        {
          "h": "1 - tail - 0.1",
          "name": "body",
          "w": 0.9,
          "x": 0.05,
          "y": 0.05
        }
      ]
    },
    {
      "category": "basic",
      "defaultSize": {
        "h": 120,
        "w": 180
      },
      "describe": "A cloud outline, for the internet, a cloud service or a vague area.",
      "id": "basic:cloud",
      "keywords": [
