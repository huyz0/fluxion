      "describe": "A box that is only text, with no border or fill by default.",
      "id": "basic:text-box",
      "keywords": [
        "text",
        "label",
        "title"
      ],
      "license": "MIT",
      "outline": {
        "path": "M 0 0 L {w} 0 L {w} {h} L 0 {h} Z"
      },
      "textRegions": [
        {
          "h": 1,
          "name": "body",
          "w": 1,
          "x": 0,
          "y": 0
        }
      ]
    },
    {
      "category": "basic",
      "decorations": [
        {
          "path": "M {w * 0.15} {h * 0.8} L {w * 0.4} {h * 0.45} L {w * 0.55} {h * 0.65} L {w * 0.65} {h * 0.55} L {w * 0.85} {h * 0.8} Z"
        },
        {
          "path": "M {w * 0.72 - min(w, h) * 0.08} {h * 0.3} A {min(w, h) * 0.08} {min(w, h) * 0.08} 0 1 1 {w * 0.72 + min(w, h) * 0.08} {h * 0.3} A {min(w, h) * 0.08} {min(w, h) * 0.08} 0 1 1 {w * 0.72 - min(w, h) * 0.08} {h * 0.3} Z"
        }
      ],
      "defaultSize": {
        "h": 120,
        "w": 160
      },
      "describe": "A rectangular frame that holds an image.",
      "id": "basic:image-frame",
      "keywords": [
        "image",
        "picture",
        "photo",
        "placeholder"
      ],
      "license": "MIT",
      "outline": {
        "path": "M 0 0 L {w} 0 L {w} {h} L 0 {h} Z"
