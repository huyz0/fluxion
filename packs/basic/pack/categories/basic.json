      "keywords": [
        "note",
        "sticky",
        "comment"
      ],
      "license": "MIT",
      "outline": {
        "path": "M 0 0 H {w - fold * min(w, h)} L {w} {fold * min(w, h)} V {h} H 0 Z"
      },
      "params": {
        "fold": {
          "default": 0.2,
          "max": 0.5,
          "min": 0,
          "type": "number"
        }
      }
    },
    {
      "category": "basic",
      "defaultSize": {
        "h": 16,
        "w": 160
      },
      "describe": "A plain line between two points, with no connector behaviour.",
      "id": "basic:line",
      "keywords": [
        "line",
        "rule",
        "divider",
        "separator"
      ],
      "license": "MIT",
      "outline": {
        "path": "M 0 {h/2} L {w} {h/2}"
      }
    },
    {
      "category": "basic",
      "defaultSize": {
        "h": 80,
        "w": 160
      },
      "describe": "An open or closed shape through points the author chooses.",
      "id": "basic:polyline",
      "keywords": [
        "polyline",
        "zigzag",
        "path"
      ],
      "license": "MIT",
      "outline": {
