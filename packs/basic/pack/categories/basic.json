        "internet",
        "network"
      ],
      "license": "MIT",
      "outline": {
        "path": "M {w/2 + 0.34 * w} {h/2 + 0 * h} A {0.14 * w} {0.14 * h} 0 0 1 {w/2 + 0.2404 * w} {h/2 + 0.2404 * h} A {0.14 * w} {0.14 * h} 0 0 1 {w/2 + 0 * w} {h/2 + 0.34 * h} A {0.14 * w} {0.14 * h} 0 0 1 {w/2 + -0.2404 * w} {h/2 + 0.2404 * h} A {0.14 * w} {0.14 * h} 0 0 1 {w/2 + -0.34 * w} {h/2 + 0 * h} A {0.14 * w} {0.14 * h} 0 0 1 {w/2 + -0.2404 * w} {h/2 + -0.2404 * h} A {0.14 * w} {0.14 * h} 0 0 1 {w/2 + 0 * w} {h/2 + -0.34 * h} A {0.14 * w} {0.14 * h} 0 0 1 {w/2 + 0.2404 * w} {h/2 + -0.2404 * h} A {0.14 * w} {0.14 * h} 0 0 1 {w/2 + 0.34 * w} {h/2 + 0 * h} Z"
      },
      "textRegions": [
        {
          "h": 0.5,
          "name": "body",
          "w": 0.6,
          "x": 0.2,
          "y": 0.25
        }
      ]
    },
    {
      "category": "basic",
      "decorations": [
        {
          "path": "M 0 {h * depth} A {w/2} {h * depth} 0 0 0 {w} {h * depth}"
        }
      ],
      "defaultSize": {
        "h": 140,
        "w": 120
      },
      "describe": "A can: the classic database or storage symbol.",
      "handles": [
        {
          "param": "depth",
          "x": "w/2",
          "y": "2 * h * depth"
        }
      ],
      "id": "basic:cylinder",
      "keywords": [
        "cylinder",
        "database",
        "storage"
      ],
      "license": "MIT",
      "outline": {
        "path": "M 0 {h * depth} V {h - h * depth} A {w/2} {h * depth} 0 0 0 {w} {h - h * depth} V {h * depth} A {w/2} {h * depth} 0 0 0 0 {h * depth} Z"
      },
      "params": {
        "depth": {
          "default": 0.15,
          "max": 0.5,
          "min": 0.02,
          "type": "number"
        }
      },
      "textRegions": [
        {
          "h": 0.5,
          "name": "body",
          "w": 0.9,
          "x": 0.05,
          "y": 0.35
        }
      ]
    },
    {
      "category": "basic",
      "defaultSize": {
        "h": 100,
        "w": 160
      },
      "describe": "A page with a wavy bottom edge, for files, reports and documents.",
      "handles": [
        {
          "param": "wave",
          "x": "w",
          "y": "h - h * wave"
        }
      ],
