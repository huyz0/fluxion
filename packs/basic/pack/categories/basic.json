        "path": "M 0 0 H {w} V {h - h * wave} C {w * 0.7} {h - 2 * h * wave} {w * 0.3} {h} 0 {h - h * wave} Z"
      },
      "params": {
        "wave": {
          "default": 0.1,
          "max": 0.25,
          "min": 0,
          "type": "number"
        }
      }
    },
    {
      "category": "basic",
      "decorations": [
        {
          "path": "M {w - fold * min(w, h)} 0 V {fold * min(w, h)} H {w}"
        }
