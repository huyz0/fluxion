{
  "name": "@fluxion/pack-themes-core",
  "version": "0.0.0",
  "description": "First-party themes pack: eight built-in themes (FR-THM-003); imports only `@fluxion/sdk`.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@fluxion/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fluxion/sdk": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
