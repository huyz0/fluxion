{
  "name": "@fluxion/pack-bpmn-lite",
  "version": "0.0.0",
  "description": "First-party BPMN-lite shape pack: activities, events, gateways, data and swimlanes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@fluxion/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "pack",
    "pack-versions.json"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fluxion/sdk": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
