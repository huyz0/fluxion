    {
      "id": "callouts:speech-rect",
      "params": {
        "tail": {
          "type": "number",
          "min": 0.05,
          "max": 0.75,
          "default": 0.2
        }
      },
      "outline": {
        "path": "M 0 0 H {w} V {h * 0.75} H {w * (tail + 0.2)} L {w * (tail - 0.05)} {h} L {w * (tail + 0.08)} {h * 0.75} H 0 Z"
      },
      "handles": [
        {
          "param": "tail",
          "x": "w * (tail - 0.05)",
          "y": "h"
        }
      ],
      "textRegions": [
        {
          "name": "body",
          "x": 0.05,
          "y": 0.05,
          "w": 0.9,
          "h": 0.65
        }
      ],
      "defaultSize": {
        "w": 180,
        "h": 110
      },
      "describe": "A rectangular speech bubble: something a person or system says.",
      "keywords": [
        "speech",
        "bubble",
        "say",
        "dialogue",
        "comment"
      ],
      "category": "speech",
      "license": "MIT"
