      "keywords": [
        "funnel",
        "conversion",
        "stages",
        "filter",
        "sales"
      ],
      "license": "MIT"
    },
    {
      "id": "infographic:funnel-layer",
      "category": "layers",
      "params": {
        "taper": {
          "type": "number",
          "min": 0,
          "max": 0.45,
          "default": 0.1
        }
      },
      "outline": {
        "path": "M 0 0 H {w} L {w - w * taper} {h} H {w * taper} Z"
      },
      "handles": [
        {
          "param": "taper",
          "x": "w * taper",
          "y": "h"
        }
      ],
      "defaultSize": {
        "w": 200,
        "h": 50
      },
      "describe": "One stage of a funnel: stack several, each narrower than the last.",
      "keywords": [
        "funnel",
        "layer",
        "stage",
        "trapezoid"
      ],
      "license": "MIT"
    },
    {
      "id": "infographic:pyramid",
