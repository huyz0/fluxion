      "outline": {
        "path": "M {w/2} 0 L {w} {h} H 0 Z"
      },
      "decorations": [
        {
          "path": "M {w/3} {h/3} H {w * 2/3}"
        },
        {
          "path": "M {w/6} {h * 2/3} H {w * 5/6}"
        }
      ],
      "defaultSize": {
        "w": 180,
        "h": 150
      },
      "describe": "A pyramid of three tiers: a hierarchy or levels of importance.",
      "keywords": [
        "pyramid",
