  "definitions": [
    {
      "id": "infographic:funnel",
      "category": "layers",
      "outline": {
        "path": "M 0 0 H {w} L {w * 0.6} {h * 0.75} V {h} H {w * 0.4} V {h * 0.75} Z"
      },
      "decorations": [
        {
          "path": "M {w * 0.133} {h * 0.25} H {w * 0.867}"
        },
        {
          "path": "M {w * 0.267} {h * 0.5} H {w * 0.733}"
        }
      ],
      "defaultSize": {
        "w": 160,
        "h": 160
      },
