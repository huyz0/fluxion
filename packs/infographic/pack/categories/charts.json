{
  "formatVersion": "1.0",
  "definitions": [
    {
      "id": "infographic:pie",
      "params": {
        "value": {
          "type": "number",
          "min": 0.01,
          "max": 0.99,
          "default": 0.65
        }
      },
      "outline": {
        "path": "M {w/2} {h/2} V 0 A {w/2} {h/2} 0 {round(value)} 1 {w/2 + w/2 * sin(2 * pi * value)} {h/2 - h/2 * cos(2 * pi * value)} Z"
      },
      "handles": [
        {
          "param": "value",
          "x": "w/2 + w/2 * sin(2 * pi * value)",
          "y": "h/2 - h/2 * cos(2 * pi * value)"
        }
      ],
      "defaultSize": {
        "w": 120,
        "h": 120
      },
      "describe": "A pie slice sized by a value: one share of a whole.",
      "keywords": [
        "pie",
        "slice",
        "share",
        "percentage",
        "chart"
      ],
      "category": "charts",
      "license": "MIT"
    },
    {
      "id": "infographic:donut",
      "params": {
        "value": {
          "type": "number",
          "min": 0.01,
          "max": 0.99,
          "default": 0.65
        },
        "inner": {
          "type": "number",
          "min": 0.2,
          "max": 0.9,
          "default": 0.6
        }
      },
      "outline": {
        "path": "M {w/2} 0 A {w/2} {h/2} 0 {round(value)} 1 {w/2 + w/2 * sin(2 * pi * value)} {h/2 - h/2 * cos(2 * pi * value)} L {w/2 + inner * w/2 * sin(2 * pi * value)} {h/2 - inner * h/2 * cos(2 * pi * value)} A {inner * w/2} {inner * h/2} 0 {round(value)} 0 {w/2} {h/2 - inner * h/2} Z"
      },
      "defaultSize": {
        "w": 120,
        "h": 120
      },
      "describe": "A donut ring segment sized by a value: progress toward a goal.",
      "keywords": [
        "donut",
        "ring",
        "progress",
        "percentage",
        "chart"
      ],
      "category": "charts",
      "license": "MIT"
    },
    {
      "id": "infographic:gauge",
      "params": {
        "value": {
          "type": "number",
          "min": 0.01,
          "max": 0.99,
          "default": 0.65
        }
      },
      "outline": {
        "path": "M 0 {h} A {w/2} {h} 0 0 1 {w} {h} Z"
      },
      "decorations": [
        {
          "path": "M {w/2} {h} L {w/2 - w * 0.4 * cos(pi * value)} {h - h * 0.8 * sin(pi * value)}"
        }
      ],
      "defaultSize": {
        "w": 160,
        "h": 80
      },
      "describe": "A half-dial gauge whose needle shows a value: a level or a score.",
      "keywords": [
        "gauge",
        "dial",
        "meter",
        "speedometer",
        "score"
      ],
      "category": "charts",
      "license": "MIT"
    },
    {
      "id": "infographic:progress",
      "params": {
        "value": {
          "type": "number",
          "min": 0.01,
          "max": 0.99,
          "default": 0.65
        }
      },
      "outline": {
        "path": "M {h/2} 0 H {w - h/2} A {h/2} {h/2} 0 0 1 {w - h/2} {h} H {h/2} A {h/2} {h/2} 0 0 1 {h/2} 0 Z"
      },
      "decorations": [
        {
          "path": "M {h * 0.25} {h * 0.25} H {h * 0.25 + (w - h/2) * value} V {h * 0.75} H {h * 0.25} Z"
        }
      ],
      "handles": [
        {
          "param": "value",
          "x": "h * 0.25 + (w - h/2) * value",
          "y": "h/2"
        }
      ],
      "defaultSize": {
        "w": 200,
        "h": 24
      },
      "describe": "A progress bar filled to a value: completion or capacity.",
      "keywords": [
        "progress",
        "bar",
        "completion",
        "capacity",
        "percentage"
      ],
      "category": "charts",
      "license": "MIT"
    },
    {
      "id": "infographic:target",
      "outline": {
        "path": "M {w/2 - w/2} {h/2} A {w/2} {h/2} 0 1 1 {w/2 + w/2} {h/2} A {w/2} {h/2} 0 1 1 {w/2 - w/2} {h/2} Z"
      },
      "decorations": [
        {
          "path": "M {w/2 - w * 0.33} {h/2} A {w * 0.33} {h * 0.33} 0 1 1 {w/2 + w * 0.33} {h/2} A {w * 0.33} {h * 0.33} 0 1 1 {w/2 - w * 0.33} {h/2} Z"
        },
        {
          "path": "M {w/2 - w * 0.16} {h/2} A {w * 0.16} {h * 0.16} 0 1 1 {w/2 + w * 0.16} {h/2} A {w * 0.16} {h * 0.16} 0 1 1 {w/2 - w * 0.16} {h/2} Z"
        }
      ],
      "defaultSize": {
        "w": 120,
        "h": 120
      },
      "describe": "A target of three rings: a goal, focus or objective.",
      "keywords": [
        "target",
        "goal",
        "bullseye",
        "focus",
        "objective"
      ],
      "category": "charts",
      "license": "MIT"
    }
  ]
}
